{
  "name": "pilo-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Your browser, on autopilot.",
  "scripts": {
    "dev": "pnpm --filter extension dev",
    "build": "pnpm --filter extension build",
    "zip": "pnpm --filter extension zip",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release": "pnpm build && bumpp",
    "release:submit": "pnpm --filter extension exec wxt submit",
    "release:secrets": "./scripts/release/sync-submit-secrets.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-formatjs": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
